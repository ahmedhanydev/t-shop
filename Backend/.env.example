# Copy to .env for local development:  cp .env.example .env
# Local development values only — never commit a real .env or reuse these in production.

NODE_ENV=development
PORT=8000

# Mongo running via docker-compose (host port 27017)
DB_URI=mongodb://127.0.0.1:27017/t-shop

# Auth — required by utils/createToken.js, otherwise signup/login return 500
JWT_SECRET_KEY=local-dev-secret-not-for-production
EXPIRE_TIME=90d

BASE_URL=http://localhost:8000

# Image uploads (utils/cloudinary.js) — needed to create categories/brands/products.
# Leave blank if you are not testing image upload paths.
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# Payments (services/orderService.js)
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Email / password reset (utils/sendEmail.js)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
